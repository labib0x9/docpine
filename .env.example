VERSION=1.0.0
SERVICE_NAME=docpine
ADDR=0.0.0.0
PORT=8080

COOKIE_SECRET=docpine-dev-secret
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LOG_DIR=logs
LOG_FILE=
LOG_FORMAT=text
LOG_LEVEL=debug
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=5
LOG_MAX_AGE=28
LOG_COMPRESS=true

DATABASE_URL=postgres://postgres:postgres@localhost:5432/docpine?sslmode=disable
RABBITMQ_URL=amqp://docpine:docpine@localhost:5672/
RABBITMQ_QUEUE=docpine.lab.runs
RABBITMQ_EVENTS_EXCHANGE=docpine.lab.events
RABBITMQ_USER=docpine
RABBITMQ_PASSWORD=docpine

LAB_RUNNER_IMAGE=alpine:3.20
LAB_RUN_TIMEOUT=10m
LAB_MEMORY=268435456
LAB_CPU_SHARES=0

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/v1/auth/callback
GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_USER_URL=https://api.github.com/user
GITHUB_FORCE_SECURE=false

NEXT_PUBLIC_API_BASE=http://localhost:8080
NEXT_PUBLIC_SSE_BASE=http://localhost:8080
