# ==========================================
# Service & Server Configuration
# ==========================================
VERSION=1.0.0
SERVICE_NAME=docpine
ADDR=0.0.0.0
PORT=8080

# ==========================================
# Runtime Backend Configuration
# Backends: docker, gvisor, firecracker
# ==========================================
RUNTIME_NAME=docker
IMAGE=alpine:3.20
NETWORK_MODE=none
SANDBOX_MEMORY=134217728
CPU_SHARES=0

# gVisor / Firecracker specific paths
RUNSC_PATH=runsc
FIRECRACKER_BIN=firecracker
KERNEL_PATH=/var/lib/docpine/vmlinux
ROOTFS_PATH=/var/lib/docpine/rootfs.ext4

# ==========================================
# Session Configuration
# ==========================================
SESSION_TTL=5m
MAX_SESSIONS=20

# ==========================================
# Abuse Prevention & Security Guard
# ==========================================
TURNSTILE_SECRET=
COOKIE_SECRET=
RATE_LIMIT_BURST=5
RATE_LIMIT_REFILL=30s

# ==========================================
# eBPF Security Sensor & Monitor API
# ==========================================
SENSOR_ADDR=:8081
SENSOR_PORT=8081

# ==========================================
# Logging Configuration
# ==========================================
# Set LOG_DIR to split logs into debug.log, info.log, warn.log, error.log:
LOG_DIR=logs
# Or set LOG_FILE for single file mode (ignored if LOG_DIR is set):
LOG_FILE=
LOG_FORMAT=text # text or json
LOG_LEVEL=debug  # debug (all logs), info, warn, error
LOG_MAX_SIZE=100 # megabytes before rotation
LOG_MAX_BACKUPS=5
LOG_MAX_AGE=28   # days
LOG_COMPRESS=true

# ==========================================
# PostgreSQL Database Configuration
# ==========================================
PG_USER=docpine
PG_PASSWORD=docpine
PG_PORT=5432
PG_ADDRESS=localhost
PG_NAME=docpine_security
PG_SSLMODE=disable
PG_SUPERUSER=postgres
PG_SUPERDB=postgres
