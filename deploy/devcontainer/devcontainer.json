{
  "name": "Docpine Dev Environment",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "-v", "/var/run/docker.sock:/var/run/docker.sock"
  ],
  "forwardPorts": [3000, 8080, 15672],
  "postCreateCommand": "go mod download",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go"
      ]
    }
  }
}
