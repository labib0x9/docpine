{
  "name": "Docpine eBPF Runtime Security Dev Environment",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "--privileged",
    "-v", "/sys/kernel/btf:/sys/kernel/btf:ro",
    "-v", "/sys/fs/bpf:/sys/fs/bpf",
    "-v", "/sys/fs/cgroup:/sys/fs/cgroup",
    "-v", "/var/run/docker.sock:/var/run/docker.sock"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "ms-vscode.cpptools"
      ]
    }
  }
}
